{
  "name": "terminal-orchestrator",
  "version": "1.0.0",
  "description": "A Windows desktop application for managing multiple terminal sessions grouped into projects",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:electron && npm run build:mobile",
    "build:electron": "electron-vite build",
    "build:mobile": "vite build --config vite.config.mobile.mts",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "rebuild": "echo '@lydell/node-pty uses prebuilt binaries - no rebuild needed'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.3",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "electron-store": "^11.0.2",
    "eventsource": "^4.1.0",
    "express": "^5.2.1",
    "ip": "^2.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "autoprefixer": "^10.4.24",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^40.4.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
