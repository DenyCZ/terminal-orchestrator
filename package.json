{
  "name": "terminal-orchestrator",
  "version": "1.0.0",
  "description": "A Windows desktop application for managing multiple terminal sessions grouped into projects",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:electron && npm run build:mobile",
    "build:electron": "electron-vite build",
    "build:mobile": "vite build --config vite.config.mobile.mts",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w node-pty",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "electron-store": "^8.2.0",
    "eventsource": "^4.1.0",
    "express": "^4.22.1",
    "ip": "^2.0.1",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.3",
    "@types/express": "^4.17.25",
    "@types/node": "^20.14.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
